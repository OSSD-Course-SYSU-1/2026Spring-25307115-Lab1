    /**
     * æ ¹æ®éŸ³è´¨è¯„åˆ†è·å–é¢œè‰²
     */
    getQualityColor(score) {
        if (score >= 90)
            return '#00FF00'; // ç»¿è‰² - ä¼˜ç§€
        if (score >= 75)
            return '#00FFFF'; // é’è‰² - è‰¯å¥½
        if (score >= 60)
            return '#FFFF00'; // é»„è‰² - ä¸€èˆ¬
        return '#FF4444'; // çº¢è‰² - è¾ƒå·®
    }
