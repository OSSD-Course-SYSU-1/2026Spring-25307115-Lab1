      this.playbackSpeed = playbackSpeed;
      
      Logger.info(`æ’­æ”¾å™¨çŠ¶æ€å·²æ¢å¤: time=${currentTime}, song=${currentSongIndex}, type=${audioType}`);
      
      // è¿”å›éœ€è¦è·³è½¬çš„æ—¶é—´ç‚¹
      return currentTime;
    } catch (error) {
      Logger.error(`æ¢å¤æ’­æ”¾å™¨çŠ¶æ€å¤±è´¥: ${error}`);
      return 0;
    }
  }
  // [EndExclude PlayerController_avplayer_methods]
}
