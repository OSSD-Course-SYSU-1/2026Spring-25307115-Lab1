          .fontSize(12)
          .fontColor('#99FFFFFF')

        Image($r('app.media.ic_public_forward'))
          .width(12)
          .height(12)
          .fillColor('#99FFFFFF')
          .rotate({ angle: this.showPanel ? 180 : 90 })
          .margin({ left: 4 })
      }
      .width('100%')
      .padding({ top: 8, bottom: 4 })
      .onClick(() => {
        this.showPanel = !this.showPanel;
      })

      // 10æ®µæ»‘å—ï¼ˆå¯å±•å¼€ï¼‰
      if (this.showPanel) {
        this.BandSliders()
