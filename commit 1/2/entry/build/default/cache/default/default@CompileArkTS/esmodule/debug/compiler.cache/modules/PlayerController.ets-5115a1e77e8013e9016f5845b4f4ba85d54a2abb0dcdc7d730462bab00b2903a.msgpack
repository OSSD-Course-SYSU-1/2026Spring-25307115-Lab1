        if (this.isAVPlayer()) {
            this.avPlayerController?.stop();
        }
        else {
            this.audioRendererController?.stop();
        }
    }
    pause() {
        if (this.isAVPlayer()) {
            this.avPlayerController?.pause();
        }
        else {
            this.audioRendererController?.pause();
        }
